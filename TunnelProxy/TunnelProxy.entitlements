<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app shells out to ssh/privoxy/networksetup and reads config / logs
	     outside a sandbox container, so App Sandbox is disabled (see plan risks). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
  <key>com.apple.developer.networking.networkextension</key>
  <array><string>$(TP_NETWORK_EXTENSION_TYPE)</string></array>
  <key>com.apple.security.application-groups</key>
  <array><string>$(TeamIdentifierPrefix)com.xwkj.tunnelproxy.approuting</string></array>
  <key>com.apple.developer.system-extension.install</key>
  <true/>
</dict>
</plist>
